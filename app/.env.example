# Copy to .env.local. Never commit real values. All secrets are server-side only.

# --- OpenRouter (image + text models) ---
OPENROUTER_API_KEY=
# Daily hard cap on model spend in USD, enforced by the cost ledger
GENERATION_DAILY_SPEND_CAP_USD=25

# --- Supabase --- (docs/cto/supabase.md). URL + service-role key: shop data in Supabase. Plus anon key: sign-in and file storage too.
# Local stack: `npx supabase start`, then copy API_URL / ANON_KEY / SERVICE_ROLE_KEY from `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test mode keys until launch) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Print on demand ---
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_API_BASE=https://api.sandbox.lulu.com
PRODIGI_API_KEY=
PRODIGI_API_BASE=https://api.sandbox.prodigi.com/v4.0

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=GreetHub <hello@example.com>

# --- Auth providers (optional Google) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Agent channel (MCP + agent API). Off unless AGENT_CHANNEL_ENABLED=1. See docs/cto/agent-channel-build-order.md
AGENT_CHANNEL_ENABLED=
AGENT_KEY_PEPPER=
AGENT_AUTH_ISSUER=
AGENT_JWKS_URL=
AGENT_MCP_RESOURCE_URL=
AGENT_DAILY_MODEL_BUDGET_USD=10
