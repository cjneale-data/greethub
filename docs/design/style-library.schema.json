{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://greethub.example/schemas/style-library.json",
  "title": "GreetHub style library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updated", "note", "ageBandDefs", "sources", "categories", "styles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string" },
    "ageBandDefs": { "type": "object" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
    "categories": { "type": "array", "minItems": 8, "maxItems": 12, "items": { "$ref": "#/definitions/category" } },
    "styles": { "type": "array", "minItems": 20, "maxItems": 40, "items": { "$ref": "#/definitions/style" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "text": { "type": "string", "minLength": 3 },
    "strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "dateRead", "tag"],
      "properties": {
        "id": { "type": "string", "pattern": "^R\\d{2}$" },
        "title": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "minLength": 3 },
        "dateRead": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "tag": { "enum": ["V", "S", "U"] }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "blurb", "order"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 3, "maxLength": 40 },
        "blurb": { "type": "string", "minLength": 10, "maxLength": 120 },
        "order": { "type": "integer", "minimum": 1 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "status", "legacyIds", "products", "ageBands", "occasions", "tones", "description", "whyThisOne", "popularity", "look", "styleString", "avoid", "swatches", "consistency", "photoReference", "print", "bestFor", "avoidFor", "tags", "synonyms", "ipSafeAliases", "risks", "brandKit", "thumbnail"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 3, "maxLength": 32 },
        "category": { "type": "string" },
        "status": { "enum": ["stable", "beta"] },
        "legacyIds": { "type": "array", "items": { "$ref": "#/definitions/id" } },
        "products": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["book", "card"] } },
        "ageBands": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["0-3", "4-7", "8-10"] } },
        "occasions": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z_]+$" } },
        "tones": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["silly", "tender", "adventurous", "elegant", "bold"] } },
        "description": { "type": "string", "minLength": 20, "maxLength": 200 },
        "whyThisOne": { "type": "string", "minLength": 15, "maxLength": 120 },
        "popularity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rating", "sources", "summary"],
          "properties": {
            "rating": { "enum": ["high", "medium", "niche", "emerging", "not_found"] },
            "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^R\\d{2}$" } },
            "summary": { "type": "string", "minLength": 20 }
          }
        },
        "look": {
          "type": "object",
          "additionalProperties": false,
          "required": ["medium", "technique", "line", "palette", "composition", "mood", "era"],
          "properties": {
            "medium": { "$ref": "#/definitions/text" }, "technique": { "$ref": "#/definitions/text" }, "line": { "$ref": "#/definitions/text" },
            "palette": { "$ref": "#/definitions/text" }, "composition": { "$ref": "#/definitions/text" }, "mood": { "$ref": "#/definitions/text" }, "era": { "$ref": "#/definitions/text" }
          }
        },
        "styleString": { "type": "string", "minLength": 120, "maxLength": 900 },
        "avoid": { "$ref": "#/definitions/strings" },
        "swatches": {
          "type": "array", "minItems": 4, "maxItems": 6,
          "items": { "type": "object", "additionalProperties": false, "required": ["hex", "name"], "properties": { "hex": { "$ref": "#/definitions/hex" }, "name": { "type": "string", "minLength": 2 } } }
        },
        "consistency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bookRating", "cardRating", "notes", "tips"],
          "properties": {
            "bookRating": { "type": "integer", "minimum": 1, "maximum": 5 },
            "cardRating": { "type": "integer", "minimum": 1, "maximum": 5 },
            "notes": { "$ref": "#/definitions/text" },
            "tips": { "$ref": "#/definitions/strings" },
            "renderNotes": { "type": "string" }
          }
        },
        "photoReference": { "type": "string", "minLength": 30 },
        "card": {
          "type": "object",
          "additionalProperties": false,
          "required": ["typography", "layout", "textSafeZone"],
          "properties": {
            "typography": {
              "type": "object", "additionalProperties": false, "required": ["display", "body", "notes"],
              "properties": { "display": { "$ref": "#/definitions/strings" }, "body": { "$ref": "#/definitions/strings" }, "notes": { "$ref": "#/definitions/text" } }
            },
            "layout": { "$ref": "#/definitions/text" },
            "textSafeZone": { "$ref": "#/definitions/text" }
          }
        },
        "print": {
          "type": "object", "additionalProperties": false, "required": ["bleed", "inkCoverage", "foilAndSpot"],
          "properties": { "bleed": { "$ref": "#/definitions/text" }, "inkCoverage": { "$ref": "#/definitions/text" }, "foilAndSpot": { "$ref": "#/definitions/text" } }
        },
        "bestFor": { "$ref": "#/definitions/strings" },
        "avoidFor": { "$ref": "#/definitions/strings" },
        "tags": { "$ref": "#/definitions/strings" },
        "synonyms": { "$ref": "#/definitions/strings" },
        "ipSafeAliases": { "type": "array", "items": { "type": "string", "minLength": 2 } },
        "risks": {
          "type": "object", "additionalProperties": false, "required": ["ip", "uncanny", "age"],
          "properties": { "ip": { "$ref": "#/definitions/text" }, "uncanny": { "$ref": "#/definitions/text" }, "age": { "$ref": "#/definitions/text" } }
        },
        "brandKit": {
          "type": "object", "additionalProperties": false, "required": ["fonts", "textColor", "paperColor", "accentColor"],
          "properties": {
            "fonts": { "type": "object", "additionalProperties": false, "required": ["display", "body"], "properties": { "display": { "type": "string" }, "body": { "type": "string" } } },
            "textColor": { "$ref": "#/definitions/hex" }, "paperColor": { "$ref": "#/definitions/hex" }, "accentColor": { "$ref": "#/definitions/hex" }
          }
        },
        "thumbnail": {
          "type": "object", "additionalProperties": false, "required": ["file", "rendered", "note"],
          "properties": {
            "file": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+\\.jpg$" },
            "bookFile": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+\\.jpg$" },
            "rendered": { "type": "boolean" },
            "note": { "type": "string", "minLength": 3 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "products": { "contains": { "const": "card" } } }, "required": ["products"] }, "then": { "required": ["card"] } }
      ]
    }
  }
}
